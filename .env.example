# Copy this to .env and fill in your keys
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# MISTRAL_API_KEY=...
#
# GitHub token used inside the sandbox (does not affect your host).
# Use a read-only fine-grained PAT to prevent agents from pushing.
# Falls back to GITHUB_TOKEN if not set.
# SANDBOX_GITHUB_TOKEN=github_pat_...
# GITHUB_TOKEN=ghp_...
#
# Sandboxes are strict by default: the agent has no general sudo, so it cannot
# flush the egress firewall, and cannot apt-get. Set to 1 to give every new
# sandbox passwordless sudo instead (same as --allow-sudo on each start). For a
# one-off need, `agent-sandbox sudo <container> on` grants it until restart.
# SANDBOX_ALLOW_SUDO=1
