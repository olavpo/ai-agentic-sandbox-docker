# Copy this to .env and fill in your keys
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# MISTRAL_API_KEY=...
#
# GitHub token used inside the sandbox (does not affect your host).
# Use a read-only fine-grained PAT to prevent agents from pushing.
# Falls back to GITHUB_TOKEN if not set.
# SANDBOX_GITHUB_TOKEN=github_pat_...
# GITHUB_TOKEN=ghp_...
#
# Set to 1 to make --strict-sudo the default for every new sandbox: the agent
# gets no general root, so it cannot flush the egress firewall. The tradeoff is
# no runtime apt-get — anything the agent needs has to be in the image, or be
# installed from the host with `docker exec -u root <container> ...`.
# Override per sandbox with --strict-sudo / --no-strict-sudo.
# SANDBOX_STRICT_SUDO=1
