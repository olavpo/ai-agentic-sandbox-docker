#!/usr/bin/env bash
# sbx — one-command project sandbox launcher.
#
# cd to a project and run `sbx`: the project's sandbox is created or resumed
# automatically (named after the directory) and you land in Claude Code,
# continuing the previous session when one exists. When the last interactive
# session exits, the sandbox is stopped (not removed).
#
# Management (build, stop, remove, sync-skills, reset-config) stays in
# agent-sandbox.
set -euo pipefail

# Resolve the repo directory through the /usr/local/bin symlink, so the
# sibling agent-sandbox.sh is found even if the PATH symlink for
# agent-sandbox is missing or stale (e.g. after a repo rename).
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}")")" && pwd)"
AGENT_SANDBOX="$SCRIPT_DIR/agent-sandbox.sh"

PROJECT_LABEL="agentic-sandbox-project"

usage() {
    cat <<'USAGE'
Usage: sbx [new|shell|list] [--agent NAME]

  sbx                Create-or-resume the sandbox for the current directory
                     and launch claude (continues the previous session when
                     one exists).
  sbx new            Same, but start a fresh claude session (no --continue).
  sbx shell          Same, but open a bash shell instead of claude.
  sbx list           List all sandboxes with their project paths.

Options:
  --agent NAME       claude (default), copilot, or vibe.

Sandboxes are named after the project directory (~/Repos/my-app →
sbx-my-app). When the last interactive session exits, the sandbox is
stopped, not removed. Management commands (build, stop, remove,
sync-skills, reset-config) live in agent-sandbox.
USAGE
}

# --- naming ----------------------------------------------------------------

# Lowercase; anything outside [a-z0-9_.-] becomes '-'; squeeze repeated '-';
# trim leading/trailing '-' and '.' (Docker names must start alphanumeric).
# LC_ALL=C so multibyte input is treated as plain junk bytes.
sanitize_name() {
    printf '%s' "$1" \
        | LC_ALL=C tr '[:upper:]' '[:lower:]' \
        | LC_ALL=C sed -E 's/[^a-z0-9_.-]+/-/g; s/-+/-/g; s/^[-.]+//; s/[-.]+$//'
}

# First 4 hex chars of the sha256 of the given string.
path_hash() {
    printf '%s' "$1" | shasum -a 256 | cut -c1-4
}

container_exists()  { docker ps -a --format '{{.Names}}' | grep -Fqx "$1"; }
container_running() { docker ps    --format '{{.Names}}' | grep -Fqx "$1"; }

container_project_label() {
    docker inspect -f "{{index .Config.Labels \"$PROJECT_LABEL\"}}" "$1" 2>/dev/null || true
}

# --- firewall handshake ----------------------------------------------------

# `docker start` returns as soon as the container is up, but the entrypoint
# configures the egress firewall asynchronously — and `docker exec` bypasses
# the entrypoint's ordering entirely. Without this wait a session can be live
# while egress is still unrestricted (measured at 2-4s in the common case,
# bounded only by how long ~40 DNS lookups plus the GitHub API call take).
# The entrypoint clears the marker on every start, so a restarted container
# cannot satisfy this with a stale one.
wait_for_firewall() {
    local c="$1" i
    # Sandboxes created before the handshake existed never write the marker, and
    # cannot be made to: image content is fixed at creation. Waiting on them
    # would block for the full timeout and then refuse to attach, so probe the
    # container's own entrypoint for the capability first.
    if ! docker exec "$c" grep -q sandbox-firewall-ready \
            /usr/local/bin/entrypoint.sh 2>/dev/null; then
        echo "Note: '$c' predates the firewall readiness handshake; attaching without it."
        echo "  It also lacks pinned DNS, fail-closed init and the self-healing loop."
        echo "  Recreate it to pick those up: agent-sandbox remove $c && sbx"
        return 0
    fi
    for ((i = 0; i < 90; i++)); do
        docker exec "$c" test -f /tmp/sandbox-firewall-ready 2>/dev/null && return 0
        # Firewall init now fails closed, so a container that refused to come
        # up unprotected is gone rather than sitting there unfiltered.
        if ! container_running "$c"; then
            echo "Error: sandbox '$c' exited during startup." >&2
            echo "  Firewall init likely failed. Inspect with: docker logs $c" >&2
            exit 1
        fi
        sleep 1
    done
    echo "Error: firewall did not come up within 90s; refusing to attach." >&2
    echo "  Inspect with: docker logs $c" >&2
    exit 1
}

# Container name for a project path: sbx-<sanitized basename>, with a short
# path hash appended when that name is taken by a different project (or by a
# pre-label container whose project path is unknown).
derive_container_name() {
    local project_dir="$1"
    local base
    base=$(sanitize_name "$(basename "$project_dir")")
    [[ -z "$base" ]] && base="project"
    local name="sbx-${base}"
    if container_exists "$name" \
            && [[ "$(container_project_label "$name")" != "$project_dir" ]]; then
        name="${name}-$(path_hash "$project_dir")"
    fi
    echo "$name"
}

# --- launch ------------------------------------------------------------------

# Claude Code stores per-project session history under
# ~/.claude/projects/<project path with non-alphanumerics replaced by '-'>.
# The project is mounted at $PROJECT_DIR (its full host path) inside the
# container; /$PROJECT_NAME is the legacy basename mount from containers
# created before PROJECT_DIR existed.
has_claude_history() {
    local container="$1"
    docker exec "$container" sh -c '
        d="$HOME/.claude/projects/$(printf %s "${PROJECT_DIR:-/$PROJECT_NAME}" | sed "s/[^A-Za-z0-9]/-/g")"
        [ -d "$d" ] && [ -n "$(ls -A "$d" 2>/dev/null)" ]
    ' 2>/dev/null
}

# The command line to exec inside the container for the chosen agent/mode.
agent_command() {
    local agent="$1" mode="$2" container="$3"
    case "$agent" in
        claude)
            local cmd="/home/agent/.local/bin/claude --dangerously-skip-permissions"
            if [[ "$mode" == "default" ]] && has_claude_history "$container"; then
                cmd="$cmd --continue"
            fi
            echo "$cmd"
            ;;
        vibe)    echo "/home/agent/.local/bin/vibe" ;;
        copilot) echo "copilot" ;;
    esac
}

# Stop the sandbox when ours was the last interactive session. Each
# `docker exec -it` session occupies one PTY; count the distinct PTYs in use
# by live processes rather than device nodes under /dev/pts — the device
# node of a just-exited session lingers for a second or two after `docker
# exec` returns (release is asynchronous), which made a session count itself
# on the way out. Exited processes are already reaped by the time the client
# returns, so the process table is race-free. The container is created with
# `docker run -dit`, so the entrypoint permanently holds one PTY (pts/0) —
# the idle baseline is 1, not 0.
maybe_stop() {
    local container="$1" open_ptys
    open_ptys=$(docker exec "$container" sh -c \
        'ps -eo tty= | grep pts | sort -u | wc -l' 2>/dev/null \
        | tr -d '[:space:]') || true
    if [[ -z "$open_ptys" ]]; then
        return 0   # container gone or docker error — never block exit on cleanup
    fi
    if [[ "$open_ptys" -le 1 ]]; then
        docker stop "$container" >/dev/null 2>&1 || true
        echo "Sandbox '$container' stopped."
    else
        echo "Sandbox '$container' left running ($((open_ptys - 1)) other session(s) attached)."
    fi
}

cmd_launch() {
    local mode="$1" agent="$2"
    local project_dir
    project_dir=$(pwd -P) || { echo "Error: cannot resolve current directory" >&2; exit 1; }

    local container
    container=$(derive_container_name "$project_dir")

    if container_running "$container"; then
        echo "Attaching to running sandbox '$container'..."
    elif container_exists "$container"; then
        echo "Starting stopped sandbox '$container'..."
        docker start "$container" >/dev/null
    else
        echo "Creating sandbox '$container' for $project_dir..."
        "$AGENT_SANDBOX" start "$project_dir" -n "$container" --agent "$agent"
    fi

    # Block until egress is actually filtered. No-op once the marker exists,
    # so the already-running and just-created paths cost nothing.
    wait_for_firewall "$container"

    # Workdir: the full-path mount (PROJECT_DIR), or the legacy /<basename>
    # mount for containers created before PROJECT_DIR existed.
    local proj_dir proj
    proj_dir=$(docker exec "$container" printenv PROJECT_DIR 2>/dev/null || true)
    if [[ -z "$proj_dir" ]]; then
        proj=$(docker exec "$container" printenv PROJECT_NAME 2>/dev/null || true)
        [[ -n "$proj" ]] && proj_dir="/$proj"
    fi
    local -a workdir=()
    [[ -n "$proj_dir" ]] && workdir=(-w "$proj_dir")

    if [[ "$mode" == "shell" ]]; then
        docker exec -it ${workdir[@]+"${workdir[@]}"} "$container" /bin/bash -l || true
    else
        local run_cmd
        run_cmd=$(agent_command "$agent" "$mode" "$container")
        docker exec -it ${workdir[@]+"${workdir[@]}"} "$container" /bin/bash -lc "exec $run_cmd" || true
    fi

    maybe_stop "$container"
}

cmd_list() {
    docker ps -a --filter "label=agentic-sandbox=true" \
        --format "table {{.Names}}\t{{.Status}}\t{{.Label \"$PROJECT_LABEL\"}}"
}

main() {
    local mode="default" agent="claude"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            new)   mode="new"; shift ;;
            shell) mode="shell"; shift ;;
            list)  cmd_list; exit 0 ;;
            --agent) agent="${2:?--agent requires a value}"; shift 2 ;;
            -h|--help|help) usage; exit 0 ;;
            *) echo "Unknown argument: $1" >&2; usage >&2; exit 1 ;;
        esac
    done
    case "$agent" in
        claude|copilot|vibe) ;;
        *) echo "Error: --agent must be one of: claude, copilot, vibe" >&2; exit 1 ;;
    esac
    cmd_launch "$mode" "$agent"
}

# When sourced with SBX_TEST=1, expose functions without running main
# (used by tests/test-sbx-naming.sh).
if [[ "${SBX_TEST:-}" != "1" ]]; then
    main "$@"
fi
