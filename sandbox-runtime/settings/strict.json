{
  "_passEnv": [
    "GIT_AUTHOR_NAME",
    "GIT_AUTHOR_EMAIL",
    "GIT_COMMITTER_NAME",
    "GIT_COMMITTER_EMAIL"
  ],
  "network": {
    "allowedDomains": [
      "api.anthropic.com",
      "*.anthropic.com",
      "registry.npmjs.org",
      "dhis2.org",
      "*.dhis2.org"
    ],
    "deniedDomains": [],
    "allowUnixSockets": [],
    "allowLocalBinding": true
  },
  "filesystem": {
    "allowWrite": [
      "./",
      "/tmp",
      "~/.claude",
      "~/.claude.json"
    ],
    "denyWrite": [
      "./.srt-settings.json",
      "./.claude/settings.json",
      "./.claude/settings.local.json"
    ],
    "denyRead": [
      "~/"
    ],
    "allowRead": [
      ".",
      "/tmp",
      "~/.claude",
      "~/.claude.json",
      "~/Repos/ai-skills"
    ]
  }
}
